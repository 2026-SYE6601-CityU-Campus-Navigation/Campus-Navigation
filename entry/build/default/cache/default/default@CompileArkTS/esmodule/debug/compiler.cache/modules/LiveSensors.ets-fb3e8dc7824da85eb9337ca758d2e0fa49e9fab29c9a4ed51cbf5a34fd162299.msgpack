    } else {
      this.InfoRow('æ°”å‹', `${this.pressure.hpa.toFixed(3)} hPa`)
      this.InfoRow('ç›¸å¯¹å˜åŒ–', this.pressureAnchor >= 0
        ? `${(this.pressure.hpa - this.pressureAnchor).toFixed(3)} hPaï¼ˆè¿›å‡ºé¡µé¢æ—¶å½’é›¶ï¼‰` : 'â€”')
      this.InfoRow('æ¨ç®—æµ·æ‹”', `${this.pressure.alt.toFixed(1)} mï¼ˆç›¸å¯¹æµ·å¹³é¢ï¼Œæ¥¼å±‚åˆ¤æ–­çº¦ 3m/å±‚ï¼‰`)
      this.InfoRow('æ›´æ–°', this.pressureMs > 0 ? fmtTime(this.pressureMs) : 'â€”')
    }
  }

  @Builder
  MagneticBody() {
    if (!this.hasMagnetic) {
      Text('æ­¤è®¾å¤‡æ— ç£åŠ›è®¡ä¼ æ„Ÿå™¨').fontSize(14).width('100%')
    } else if (this.mag === null) {
      Text('ç­‰å¾…è¯»æ•°â€¦').fontSize(14).width('100%')
    } else {
      this.InfoRow('X / Y / Z', `${this.mag.x.toFixed(2)} / ${this.mag.y.toFixed(2)} / ${this.mag.z.toFixed(2)} ÂµT`)
      this.InfoRow('æ€»åœºå¼º', `${this.mag.mag.toFixed(2)} ÂµTï¼ˆåœ°ç£åŸºå‡†çº¦ 45-55ï¼‰`)
      this.InfoRow('æ–¹ä½è§’', this.mag.az !== undefined ? `${this.mag.az.toFixed(0)}Â°` : 'ä¸å¯ç”¨')
      this.InfoRow('æ›´æ–°', this.magMs > 0 ? fmtTime(this.magMs) : 'â€”')
    }
  }

  @Builder
  WifiBody() {
    if (this.lastScanMs === 0) {
      Text('å°šæœªå®Œæˆæ‰«æ').fontSize(12).fontColor('#99000000').width('100%')
    } else {
      Text(`æœ€è¿‘æ‰«æï¼š${fmtTime(this.lastScanMs)}`)
        .fontSize(12)
        .fontColor('#99000000')
        .width('100%')
    }
    if (this.wifi.length === 0) {
      Text('æš‚æ—  WiFi æ‰«æç»“æœ â€”â€” éœ€æˆæƒä½ç½®æƒé™å¹¶æ‰“å¼€ç³»ç»Ÿå®šä½å¼€å…³ï¼›æ‰«æå—ç³»ç»ŸèŠ‚æµï¼ˆçº¦ 30 ç§’ä¸€æ¬¡ï¼‰')
        .fontSize(12)
        .fontColor('#99000000')
        .width('100%')
    } else {
      ForEach(this.wifi, (ap: WifiView) => {
        Column({ space: 2 }) {
          Text(`${ap.ssid.length > 0 ? ap.ssid : '(éšè—ç½‘ç»œ)'}  ${ap.bssid}`)
            .fontSize(14)
            .width('100%')
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          Text(`${ap.rssi} dBm Â· ${ap.freq} MHz`)
            .fontSize(12)
            .fontColor('#99000000')
            .width('100%')
        }.width('100%').padding({ top: 6, bottom: 6 })
      }, (ap: WifiView) => ap.bssid)
    }
  }

  @Builder
  InfoRow(label: string, value: string) {
    Row() {
      Text(label).fontSize(14).fontColor('#99000000').width(72)
      Text(value).fontSize(14)
    }.width('100%')
  }

  /** ã€Œè·ä¸Šæ¬¡å®šä½ã€æ–‡æ¡ˆï¼šéš tick å®æ—¶å˜åŒ–ï¼Œè¯æ˜å®šä½å¡ç‰‡åœ¨ç­‰ GPS ä¿®æ­£ */
  private locAgoText(): string {
    if (this.tickMs <= 0 || this.loc === null) {
      return '';
    }
    const ago = Math.max(0, Math.floor((this.tickMs - this.loc.timeMs) / 1000));
    return ago < 60 ? `${ago} ç§’å‰` : `${Math.floor(ago / 60)} åˆ†é’Ÿå‰ï¼ˆå®¤å†… GPS ä¿¡å·å¼±å±æ­£å¸¸ï¼‰`;
  }
}
