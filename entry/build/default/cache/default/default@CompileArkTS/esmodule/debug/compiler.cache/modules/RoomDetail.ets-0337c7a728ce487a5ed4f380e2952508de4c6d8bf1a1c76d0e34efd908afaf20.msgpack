import { Marker, Room, markerTypeOptions } from '../data/Entities';
import { Store } from '../data/Store';
import { captureSnapshot } from '../sensors/SensorSnapshotter';
import { coordText } from '../common/Utils';

@CustomDialog
struct AddMarkerDialog {
  controller?: CustomDialogController;
  onSave?: (name: string, typeLabel: string) => void;
  @State name: string = '';
  @State typeLabel: string = 'å‰é—¨';

  build() {
    Column({ space: 12 }) {
      Text('æ·»åŠ æ ‡è®°').fontSize(18).fontWeight(FontWeight.Medium).width('100%')
      TextInput({ placeholder: 'åç§°ï¼ˆå¦‚ï¼šå‰é—¨ï¼‰' })
        .onChange((v: string) => {
          this.name = v;
        })
      Select(markerTypeOptions())
        .selected(0)
        .onSelect((index: number, value: string) => {
          this.typeLabel = value;
        })
        .width('100%')
      Text('ä¿å­˜æ—¶å°†è‡ªåŠ¨é‡‡é›†ï¼šå®šä½ + æ°”å‹ + åœ°ç£å¿«ç…§')
        .fontSize(12)
        .fontColor('#99000000')
        .width('100%')
      Row({ space: 12 }) {
        Button('å–æ¶ˆ').onClick(() => {
          this.controller?.close();
        })
        Button('é‡‡é›†å¹¶ä¿å­˜')
          .enabled(this.name.trim().length > 0)
          .onClick(() => {
            this.controller?.close();
            if (this.onSave) {
              this.onSave(this.name, this.typeLabel);
            }
          })
      }.width('100%').justifyContent(FlexAlign.End)
    }.padding(16).width('100%')
  }
}

@Component
export struct RoomDetailPage {
  roomId: number = -1;
  onBack: () => void = () => {
  };
  @State room: Room | undefined = undefined;
  @State markers: Marker[] = [];

  private reload = (): void => {
    Store.getRoom(this.roomId).then((r: Room | undefined) => {
      if (r) {
        this.room = r;
      }
    });
    Store.listMarkers(this.roomId).then((ms: Marker[]) => {
      this.markers = ms;
    });
  };

  aboutToAppear(): void {
    this.reload();
    Store.subscribe(this.reload);
  }

  aboutToDisappear(): void {
    Store.unsubscribe(this.reload);
  }

  private addDialog: CustomDialogController = new CustomDialogController({
    builder: AddMarkerDialog({
      onSave: (name: string, typeLabel: string): void => {
        this.addMarker(name, typeLabel);
      }
    }),
    customStyle: false
  });

  private addMarker(name: string, typeLabel: string): void {
    captureSnapshot().then((s) => {
      Store.insertMarker(this.roomId, name.trim(), typeLabel,
        s.latitude, s.longitude, s.altitude, s.accuracy,
        s.pressureHpa, s.magneticX, s.magneticY, s.magneticZ)
        .then(() => {
          promptAction.showToast({ message: `å·²é‡‡é›†å¹¶ä¿å­˜ã€Œ${name}ã€çš„ä¼ æ„Ÿå™¨å¿«ç…§` });
        });
    });
  }

  private setBasePoint(): void {
    captureSnapshot().then((s) => {
      Store.updateRoomBase(this.roomId, s.latitude, s.longitude, s.altitude, s.pressureHpa)
        .then(() => {
          promptAction.showToast({ message: 'å·²è®°å½•æˆ¿é—´åŸºå‡†ç‚¹' });
        });
    });
  }

  private confirmDeleteRoom(): void {
    promptAction.showDialog({
      title: 'åˆ é™¤æˆ¿é—´',
      message: 'å°†åŒæ—¶åˆ é™¤è¯¥æˆ¿é—´çš„æ‰€æœ‰æ ‡è®°ï¼Œç¡®å®šåˆ é™¤ï¼Ÿ',
      buttons: [
        { text: 'å–æ¶ˆ', color: '#0A59F7' },
        { text: 'åˆ é™¤', color: '#E84026' }
      ]
    }).then((res: promptAction.ShowDialogSuccessResponse) => {
      if (res.index === 1) {
        Store.deleteRoom(this.roomId).then(() => {
          this.onBack();
        });
      }
    }).catch(() => {
    });
  }

  build() {
    Stack({ alignContent: Alignment.BottomEnd }) {
      Column() {
        Row() {
          Button('â€¹ è¿”å›').fontSize(14).onClick(() => {
            this.onBack();
          })
          Text(this.room ? this.room.name : 'æˆ¿é—´')
            .fontSize(18)
            .fontWeight(FontWeight.Medium)
            .margin({ left: 12 })
          Blank()
          Button('è®°åŸºå‡†ç‚¹').fontSize(12).onClick(() => {
            this.setBasePoint();
          })
          Button('åˆ é™¤').fontSize(12).fontColor('#E84026').margin({ left: 8 }).onClick(() => {
            this.confirmDeleteRoom();
          })
        }.width('100%').padding({ left: 8, right: 12, top: 10, bottom: 10 })
        Divider()

        List() {
          ListItem() {
            this.BasePointCard()
          }
          ForEach(this.markers, (m: Marker) => {
            ListItem() {
              this.MarkerRow(m)
            }
          }, (m: Marker) => m.id + '')
        }
        .width('100%')
        .layoutWeight(1)
        .divider({ strokeWidth: 0.5, color: '#1A000000' })
      }.width('100%').height('100%')

      Button('æ·»åŠ æ ‡è®°').margin(16).onClick(() => {
        this.addDialog.open();
      })
    }.width('100%').height('100%')
  }

  @Builder
  BasePointCard() {
    Column({ space: 4 }) {
      Text('æˆ¿é—´åŸºå‡†ç‚¹').fontSize(14).fontWeight(FontWeight.Medium).width('100%')
      Text(this.room ? coordText(this.room.latitude, this.room.longitude) : '-')
        .fontSize(14)
        .width('100%')
      Text(this.room && this.room.pressureHpa !== undefined
        ? `æ°”å‹ ${this.room.pressureHpa.toFixed(1)} hPa` : 'æ°”å‹ï¼šæœªé‡‡é›†')
        .fontSize(12)
        .fontColor('#99000000')
        .width('100%')
    }.width('100%').padding(16)
  }

  @Builder
  MarkerRow(m: Marker) {
    Column({ space: 4 }) {
      Row() {
        Text(m.name).fontSize(16)
        Blank()
        Text(m.pressureHpa !== undefined ? `${m.pressureHpa.toFixed(1)} hPa` : '')
          .fontSize(12)
          .fontColor('#99000000')
      }.width('100%')
      Text(`${m.markerType} Â· ${coordText(m.latitude, m.longitude)}`)
        .fontSize(13)
        .fontColor('#99000000')
        .width('100%')
    }
    .width('100%')
    .padding({ left: 16, right: 16, top: 12, bottom: 12 })
    .gesture(LongPressGesture().onAction(() => {
      Store.deleteMarker(m.id).then(() => {
        promptAction.showToast({ message: `å·²åˆ é™¤ã€Œ${m.name}ã€` });
      });
    }))
  }
}
