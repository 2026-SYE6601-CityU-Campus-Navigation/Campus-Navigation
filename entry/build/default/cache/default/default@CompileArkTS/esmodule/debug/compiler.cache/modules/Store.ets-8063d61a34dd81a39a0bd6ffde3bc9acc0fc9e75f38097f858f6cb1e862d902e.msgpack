  /** æ–°å»ºè½¨è¿¹ä¼šè¯ï¼Œè¿”å›è¡Œ idã€‚areaId å¿…å¡«ï¼ˆUI å±‚å¼ºåˆ¶å…ˆé€‰åŒºåŸŸï¼‰ */
  static async insertTrack(name: string, areaId: number): Promise<number> {
    await Store.ready;
    const bucket: relationalStore.ValuesBucket = {
      'name': name,
      'areaId': areaId,
      'startedAt': Date.now(),
      'pointCount': 0
    };
