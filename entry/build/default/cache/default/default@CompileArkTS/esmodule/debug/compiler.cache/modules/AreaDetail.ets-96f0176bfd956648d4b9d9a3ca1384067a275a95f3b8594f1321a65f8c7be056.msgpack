        Scroll() {
          Column({ space: 12 }) {
            // æˆ¿é—´
            Column({ space: 8 }) {
              Row() {
                Text(`æˆ¿é—´ï¼ˆ${this.rooms.length}ï¼‰`).fontSize(16).fontWeight(FontWeight.Medium)
                Blank()
                Button('æ·»åŠ æˆ¿é—´').fontSize(13).onClick(() => {
                  this.addRoomDialog.open();
                })
              }.width('100%')
              if (this.rooms.length === 0) {
                Text('è¯¥åŒºåŸŸè¿˜æ²¡æœ‰æˆ¿é—´').fontSize(13).fontColor('#99000000').width('100%')
              }
              ForEach(this.rooms, (r: Room) => {
                Row() {
                  Column({ space: 4 }) {
                    Text(r.name).fontSize(15).width('100%')
                    Text(r.note.length > 0 ? r.note : 'ç‚¹å‡»æ‰“å¼€ï¼Œå¯æ·»åŠ å‰é—¨/åé—¨ç­‰æ ‡è®°')
                      .fontSize(12)
                      .fontColor('#99000000')
                      .width('100%')
                  }.layoutWeight(1)
                  Text('â€º').fontSize(18).fontColor('#99000000')
                }
                .width('100%')
                .padding({ top: 10, bottom: 10 })
                .onClick(() => {
                  this.onOpenRoom(r.id);
