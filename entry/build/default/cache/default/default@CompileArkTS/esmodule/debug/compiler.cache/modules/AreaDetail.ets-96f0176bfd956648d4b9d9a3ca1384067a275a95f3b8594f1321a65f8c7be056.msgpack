        .scrollBar(BarState.Off)
      }.width('100%').height('100%')

      // FABï¼šæœªåˆ†åŒºä¸å…è®¸å¼€å§‹è®°å½•ï¼›è®°å½•ä¸­æ¨ªå¹…è‡ªå¸¦åœæ­¢æŒ‰é’®ï¼ˆå¿ƒè·³é‡å»ºé©±åŠ¨åˆ·æ–°ï¼‰
      ForEach([this.heartbeat], (h: number) => {
        if (!AppStorage.get<boolean>('rm_recording') && !this.isUnassigned()) {
          Button('å¼€å§‹è®°å½•').margin(16).onClick(() => {
            this.openStartDialog();
          })
        }
      }, (h: number) => h + '')
    }.width('100%').height('100%')
  }
}
