  private areaName(): string {
    if (this.areaId === UNASSIGNED_AREA_ID) {
      return 'æœªåˆ†åŒº';
    }
    return this.area ? this.area.name : 'åŒºåŸŸ';
  }

  private isUnassigned(): boolean {
    return this.areaId === UNASSIGNED_AREA_ID;
  }

  private reload = (): void => {
    if (this.isUnassigned()) {
      this.area = {
        id: UNASSIGNED_AREA_ID,
        name: 'æœªåˆ†åŒº',
        note: 'å‡çº§å‰çš„æ—§æ•°æ®ï¼Œå°šæœªå½’å±ä»»ä½•åŒºåŸŸ',
        roomCount: 0,
        trackCount: 0,
        createdAt: 0
      };
    } else {
      Store.getArea(this.areaId).then((a: Area | undefined) => {
        if (a) {
          this.area = a;
        }
      });
    }
    Store.listRooms(this.areaId).then((r: Room[]) => {
      this.rooms = r;
    });
    Store.listTracksInArea(this.areaId).then((t: Track[]) => {
      this.tracks = t;
    });
  };

  aboutToAppear(): void {
    this.reload();
    Store.subscribe(this.reload);
    this.timer = setInterval(() => {
      this.heartbeat++;
    }, 500);
  }

  aboutToDisappear(): void {
    Store.unsubscribe(this.reload);
    if (this.timer >= 0) {
      clearInterval(this.timer);
      this.timer = -1;
    }
  }

  private addRoomDialog: CustomDialogController = new CustomDialogController({
    builder: AddRoomDialog({
      onSave: (name: string, note: string): void => {
        const n = name.trim();
        if (n.length === 0) {
          return;
        }
        Store.insertRoom(n, note.trim(), this.areaId).then((id: number) => {
          this.onOpenRoom(id);
        });
      }
    }),
    customStyle: false
  });

  private startDialog: CustomDialogController | null = null;

  /** æ‰“å¼€æ—¶åŠ¨æ€æ„é€ ï¼ˆæˆå‘˜åˆå§‹åŒ–é˜¶æ®µ this.areaId å¯èƒ½å°šæœªèµ‹å€¼ï¼Œé¡»åœ¨ç‚¹å‡»æ—¶è¯»å–ï¼‰ */
  private openStartDialog(): void {
    this.startDialog = new CustomDialogController({
      builder: StartTrackDialog({
        defaultAreaId: this.areaId,
        onStart: (name: string, areaId: number): void => {
          TrackRecorder.get().start(name, areaId).catch(() => {
            promptAction.showToast({ message: 'å¯åŠ¨è®°å½•å¤±è´¥' });
          });
        }
      }),
      customStyle: false
    });
    this.startDialog.open();
  }

  private exportZip(): void {
    const name = this.areaName();
    promptAction.showToast({ message: `æ­£åœ¨æ‰“åŒ…ã€Œ${name}ã€çš„æ•°æ®â€¦` });
    Exporter.exportAreaZip(this.areaId, name).then((zipName: string) => {
      promptAction.showToast({ message: `å·²å¯¼å‡º ${zipName}` });
    }).catch((e: Error) => {
      promptAction.showToast({ message: e.message });
    });
  }

  private deleteArea(): void {
    promptAction.showDialog({
      title: `åˆ é™¤åŒºåŸŸã€Œ${this.areaName()}ã€`,
      message: `æˆ¿é—´ ${this.rooms.length} ä¸ª Â· è½¨è¿¹ ${this.tracks.length} æ¡ã€‚\nç§»å…¥æœªåˆ†åŒºï¼šä¿ç•™å…¨éƒ¨æ•°æ®ï¼›å½»åº•åˆ é™¤ï¼šæ•°æ®ä¸ç…§ç‰‡å°†å…¨éƒ¨ä¸¢å¤±ã€‚`,
      buttons: [
        { text: 'å–æ¶ˆ', color: '#0A59F7' },
        { text: 'ç§»å…¥æœªåˆ†åŒº', color: '#99000000' },
        { text: 'å½»åº•åˆ é™¤', color: '#E84026' }
      ]
    }).then((res: promptAction.ShowDialogSuccessResponse) => {
      if (res.index === 1) {
        Store.moveAreaToUnassigned(this.areaId).then(() => {
          promptAction.showToast({ message: 'å·²ç§»å…¥æœªåˆ†åŒº' });
          this.onBack();
        });
      } else if (res.index === 2) {
        // è‹¥æ­£åœ¨è®°å½•è¯¥åŒºåŸŸçš„è½¨è¿¹ï¼Œå…ˆåœæ­¢ï¼Œé¿å…å†™å…¥å·²åˆ é™¤çš„è½¨è¿¹
        const rec = TrackRecorder.get();
        if (rec.isRunning()) {
          rec.stop().catch(() => {
          });
        }
        Store.deleteAreaCascade(this.areaId).then(() => {
          promptAction.showToast({ message: 'åŒºåŸŸå·²åˆ é™¤' });
          this.onBack();
        });
      }
    }).catch(() => {
    });
  }

  private trackSub(t: Track): string {
    const end = t.endedAt !== undefined ? t.endedAt : t.startedAt;
    let s =
      `${fmtTime(t.startedAt)} Â· æ—¶é•¿ ${fmtDuration(Math.floor((end - t.startedAt) / 1000))} Â· ${t.pointCount} ç‚¹`;
    if (t.endedAt === undefined) {
      s += ' Â· è¿›è¡Œä¸­';
    }
    return s;
  }

  build() {
    Stack({ alignContent: Alignment.BottomEnd }) {
      Column() {
        Row() {
          Button('â€¹ è¿”å›').fontSize(14).onClick(() => {
            this.onBack();
