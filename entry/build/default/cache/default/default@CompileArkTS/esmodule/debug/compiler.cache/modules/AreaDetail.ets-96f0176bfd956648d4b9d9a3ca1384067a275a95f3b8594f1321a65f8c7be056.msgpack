            }.width('100%').padding(16).backgroundColor('#FFF7F7F7').borderRadius(12)

            // è½¨è¿¹
            Column({ space: 8 }) {
              Row() {
                Text(`è½¨è¿¹ï¼ˆ${this.tracks.length}ï¼‰`).fontSize(16).fontWeight(FontWeight.Medium)
                Blank()
                if (this.isUnassigned()) {
                  Text('é¡»åœ¨å…·ä½“åŒºåŸŸä¸­è®°å½•è½¨è¿¹')
                    .fontSize(12)
                    .fontColor('#99000000')
                } else {
                  Button('å¼€å§‹è®°å½•').fontSize(13).onClick(() => {
                    this.openStartDialog();
                  })
                }
              }.width('100%')
              if (this.tracks.length === 0) {
                Text(this.isUnassigned()
                  ? 'æœªåˆ†åŒºæ²¡æœ‰è½¨è¿¹'
                  : 'è¯¥åŒºåŸŸè¿˜æ²¡æœ‰è½¨è¿¹ï¼Œç‚¹ã€Œå¼€å§‹è®°å½•ã€é‡‡é›†ï¼ˆé€”ä¸­å¯æ‹ç…§/æ‰“æ ‡ç­¾ï¼‰')
                  .fontSize(13)
                  .fontColor('#99000000')
                  .width('100%')
              }
              ForEach(this.tracks, (t: Track) => {
                Row() {
                  Column({ space: 4 }) {
                    Text(t.name).fontSize(15).width('100%')
                    Text(this.trackSub(t)).fontSize(12).fontColor('#99000000').width('100%')
