    drawPath() {
        if (this.canvasW <= 0 || this.canvasH <= 0) {
            return;
        }
        const geo = this.points.filter((p) => {
            return p.latitude !== undefined && p.longitude !== undefined;
        });
        const c = this.ctx;
        c.clearRect(0, 0, this.canvasW, this.canvasH);
        if (geo.length < 2) {
            return;
