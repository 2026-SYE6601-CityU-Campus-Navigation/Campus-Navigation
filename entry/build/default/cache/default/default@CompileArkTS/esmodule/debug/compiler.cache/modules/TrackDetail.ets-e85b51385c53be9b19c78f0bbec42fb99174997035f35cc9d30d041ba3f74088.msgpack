        const lats = [];
        const lngs = [];
        geo.forEach((p) => {
            lats.push(p.latitude);
            lngs.push(p.longitude);
        });
        let minLat = lats[0], maxLat = lats[0], minLng = lngs[0], maxLng = lngs[0];
        for (let i = 1; i < lats.length; i++) {
            if (lats[i] < minLat) {
                minLat = lats[i];
            }
            if (lats[i] > maxLat) {
                maxLat = lats[i];
            }
            if (lngs[i] < minLng) {
                minLng = lngs[i];
            }
            if (lngs[i] > maxLng) {
                maxLng = lngs[i];
            }
        }
        const spanLat = Math.max(maxLat - minLat, 1e-6);
        const spanLng = Math.max(maxLng - minLng, 1e-6);
        const pad = 16;
