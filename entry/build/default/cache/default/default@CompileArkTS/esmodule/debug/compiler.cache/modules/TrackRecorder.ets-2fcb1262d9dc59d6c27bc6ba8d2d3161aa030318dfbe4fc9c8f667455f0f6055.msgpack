            sensor.on(sensor.SensorId.BAROMETER, this.pressureCb);
        }
        catch (e) {
        }
        try {
            sensor.on(sensor.SensorId.MAGNETIC_FIELD, this.magCb);
        }
        catch (e) {
        }
