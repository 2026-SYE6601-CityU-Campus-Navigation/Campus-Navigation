export class TrackRecorder {
    constructor() {
        this.running = false;
        this.trackId = -1;
        this.t0 = 0;
        this.pointCount = 0;
        this.buffer = [];
        this.sampleTimer = -1;
        this.elapsedTimer = -1;
        this.wifiTimer = -1;
        this.lastLoc = null;
        this.lastPressure = undefined;
        this.lastMag = [0, 0, 0];
        this.hasMag = false;
        this.lastAccel = [0, 0, 0];
        this.hasAccel = false;
        this.lastHeading = undefined;
        this.lastWifi = '';
        this.lastWifiCount = 0;
        this.pressureCb = (d) => {
            this.lastPressure = d.pressure;
        };
        this.magCb = (d) => {
            this.lastMag = [d.x, d.y, d.z];
            this.hasMag = true;
        };
        this.accelCb = (d) => {
            this.lastAccel = [d.x, d.y, d.z];
