import { Area } from '../data/Entities';
import { Store, UNASSIGNED_AREA_ID } from '../data/Store';
import { AreaDetailPage } from './AreaDetail';
import { TrackListPage } from './TrackList';
import { TrackDetailPage } from './TrackDetail';
import { LiveSensorsPage } from './LiveSensors';
import { RoomDetailPage } from './RoomDetail';

@Entry
@Component
struct Index {
  @Provide('navStack') navStack: NavPathStack = new NavPathStack();

  build() {
    Navigation(this.navStack) {
      AreaListPage({
        onOpenArea: (id: number) => {
          this.navStack.pushPath({ name: 'area', param: id });
        },
        onTracks: () => {
          this.navStack.pushPath({ name: 'tracks' });
        },
        onLive: () => {
          this.navStack.pushPath({ name: 'live' });
        }
      })
    }
    .hideTitleBar(true)
    .mode(NavigationMode.Stack)
    .navDestination(this.pageMapBuilder)
  }

  @Builder
  pageMapBuilder(name: string, param?: Object) {
    if (name === 'tracks') {
      NavDestination() {
        TrackListPage({
          onBack: () => {
            this.navStack.pop();
          },
          onOpenTrack: (id: number) => {
            this.navStack.pushPath({ name: 'track', param: id });
          }
        })
      }
      .hideTitleBar(true)
    } else if (name === 'live') {
      NavDestination() {
        LiveSensorsPage({
          onBack: () => {
            this.navStack.pop();
          }
        })
      }
      .hideTitleBar(true)
    } else if (name === 'room') {
      NavDestination() {
        RoomDetailPage({
          roomId: param as number,
          onBack: () => {
            this.navStack.pop();
          }
        })
      }
      .hideTitleBar(true)
    } else if (name === 'track') {
      NavDestination() {
        TrackDetailPage({
          trackId: param as number,
          onBack: () => {
            this.navStack.pop();
          }
        })
      }
      .hideTitleBar(true)
    } else if (name === 'area') {
      NavDestination() {
        AreaDetailPage({
          areaId: param as number,
          onBack: () => {
            this.navStack.pop();
          },
          onOpenRoom: (id: number) => {
            this.navStack.pushPath({ name: 'room', param: id });
          },
          onOpenTrack: (id: number) => {
            this.navStack.pushPath({ name: 'track', param: id });
          }
        })
      }
      .hideTitleBar(true)
    }
  }
}

@CustomDialog
struct AddAreaDialog {
  controller?: CustomDialogController;
  onSave?: (name: string, note: string) => void;
  @State name: string = '';
  @State note: string = '';

  build() {
    Column({ space: 12 }) {
      Text('æ–°å»ºåŒºåŸŸ').fontSize(18).fontWeight(FontWeight.Medium).width('100%')
      TextInput({ placeholder: 'åŒºåŸŸåç§°ï¼ˆå¦‚ï¼šAC1 ä¸‰æ¥¼ / å›¾ä¹¦é¦†äºŒå±‚ï¼‰' })
        .onChange((v: string) => {
          this.name = v;
        })
      TextInput({ placeholder: 'å¤‡æ³¨ï¼ˆå¯é€‰ï¼Œå¦‚ï¼šå« 301-320 æ•™å®¤ï¼‰' })
        .onChange((v: string) => {
          this.note = v;
        })
      Row({ space: 12 }) {
        Button('å–æ¶ˆ').onClick(() => {
          this.controller?.close();
        })
        Button('åˆ›å»º')
          .enabled(this.name.trim().length > 0)
          .onClick(() => {
            this.controller?.close();
            if (this.onSave) {
              this.onSave(this.name.trim(), this.note.trim());
            }
          })
      }.width('100%').justifyContent(FlexAlign.End)
    }.padding(16).width('100%')
  }
}

@Component
struct AreaListPage {
  @State areas: Area[] = [];
  @State unassignedRoomCount: number = 0;
  @State unassignedTrackCount: number = 0;
  onOpenArea: (id: number) => void = (id: number) => {
  };
  onTracks: () => void = () => {
  };
  onLive: () => void = () => {
  };

  private reload = (): void => {
    Store.listAreas().then((list: Area[]) => {
      this.areas = list;
    });
    Store.listRooms(UNASSIGNED_AREA_ID).then((r) => {
      this.unassignedRoomCount = r.length;
    });
    Store.listTracksInArea(UNASSIGNED_AREA_ID).then((t) => {
      this.unassignedTrackCount = t.length;
    });
  };

  aboutToAppear(): void {
    this.reload();
    Store.subscribe(this.reload);
  }

  aboutToDisappear(): void {
    Store.unsubscribe(this.reload);
  }

  private addDialog: CustomDialogController = new CustomDialogController({
    builder: AddAreaDialog({
      onSave: (name: string, note: string): void => {
        const n = name.trim();
        if (n.length === 0) {
          return;
        }
        Store.insertArea(n, note.trim()).then((id: number) => {
          this.onOpenArea(id);
        });
      }
    }),
    customStyle: false
  });

  build() {
    Stack({ alignContent: Alignment.BottomEnd }) {
      Column() {
        Row() {
          Text('RoomMarker æ•°æ®é‡‡é›†').fontSize(20).fontWeight(FontWeight.Bold)
          Blank()
          Button('å…¨éƒ¨è½¨è¿¹').fontSize(13).onClick(() => {
            this.onTracks();
          })
          Button('å®žæ—¶').fontSize(13).margin({ left: 8 }).onClick(() => {
            this.onLive();
          })
        }.width('100%').padding({ left: 16, right: 12, top: 14, bottom: 12 })
        Divider()

        if (this.areas.length === 0 && this.unassignedRoomCount === 0 && this.unassignedTrackCount === 0) {
          Column() {
            Blank()
            Text('è¿˜æ²¡æœ‰åŒºåŸŸï¼Œç‚¹å‡»å³ä¸‹è§’æ–°å»º').fontColor('#99000000')
            Text('æŒ‰æ¥¼æ ‹/æ¥¼å±‚åˆ’åŒºåŸŸåŽå¼€å§‹æ”¶é›†æ•°æ®').fontSize(12).fontColor('#66000000')
            Blank()
          }.width('100%').layoutWeight(1)
        } else {
          List() {
            if (this.unassignedRoomCount + this.unassignedTrackCount > 0) {
              ListItem() {
                Column({ space: 4 }) {
                  Text('æœªåˆ†åŒºæ•°æ®').fontSize(16).width('100%')
                  Text(`æ—§æ•°æ® Â· æˆ¿é—´ ${this.unassignedRoomCount} Â· è½¨è¿¹ ${this.unassignedTrackCount}`)
                    .fontSize(13)
                    .fontColor('#99000000')
                    .width('100%')
                }.width('100%').padding({ left: 16, right: 16, top: 12, bottom: 12 })
              }.onClick(() => {
                this.onOpenArea(UNASSIGNED_AREA_ID);
              })
            }
            ForEach(this.areas, (a: Area) => {
              ListItem() {
                Column({ space: 4 }) {
                  Text(a.name).fontSize(16).width('100%')
                  Text(a.note.length > 0
                    ? `${a.note} Â· æˆ¿é—´ ${a.roomCount} Â· è½¨è¿¹ ${a.trackCount}`
                    : `æˆ¿é—´ ${a.roomCount} Â· è½¨è¿¹ ${a.trackCount}`)
                    .fontSize(13)
                    .fontColor('#99000000')
                    .width('100%')
                }.width('100%').padding({ left: 16, right: 16, top: 12, bottom: 12 })
              }.onClick(() => {
                this.onOpenArea(a.id);
              })
            }, (a: Area) => a.id + '')
          }
          .width('100%')
          .layoutWeight(1)
          .divider({ strokeWidth: 0.5, color: '#1A000000' })
        }
      }.width('100%').height('100%')

      Button('æ–°å»ºåŒºåŸŸ').margin(16).onClick(() => {
        this.addDialog.open();
      })
    }.width('100%').height('100%')
  }
}
